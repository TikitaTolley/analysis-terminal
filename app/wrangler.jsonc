{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analysis-terminal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "LEAGUE_ID": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "analysis-terminal",
      "database_id": "559627ae-675f-4bb0-97c8-5a7d6f7ec614"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "2001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "STATUS_LIMIT",
      "namespace_id": "2002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "DEVICE_POLL_LIMIT",
      "namespace_id": "2003",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "DEVICE_COMMAND_LIMIT",
      "namespace_id": "2004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
